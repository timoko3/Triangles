{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TRIANGLES_BUILD_APP": false,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release with tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "app",
      "displayName": "Triangle input parser",
      "inherits": "debug",
      "cacheVariables": {
        "TRIANGLES_BUILD_APP": true,
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{GENERAL_FUNCTIONS_CLANG_SCAN_DEPS}"
      }
    },
    {
      "name": "opengl-demo",
      "displayName": "OpenGL demo",
      "inherits": "debug",
      "cacheVariables": {
        "TRIANGLES_BUILD_OPENGL_DEMO": true
      }
    },
    {
      "name": "quality",
      "displayName": "Compilation database for clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "TRIANGLES_BUILD_APP": true,
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS}",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "$env{GENERAL_FUNCTIONS_CLANG_SCAN_DEPS}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "app",
      "configurePreset": "app"
    },
    {
      "name": "quality",
      "configurePreset": "quality"
    },
    {
      "name": "opengl-demo",
      "configurePreset": "opengl-demo"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "app",
      "configurePreset": "app",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
